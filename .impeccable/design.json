  "components": [
    {
      "name": "Buton primar (hol)",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acțiunea principală din hol: galben cu text negru, săgeată care alunecă la hover.",
      "html": "<button class=\"ds-btn-primary\">Trimite tichetul <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" class=\"ds-ar\"><path d=\"M4 12h15M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 16px;border:0;border-radius:2px;background:#FFC400;color:#0B0C0E;font:700 14px/1 Archivo,system-ui,sans-serif;font-stretch:108%;box-shadow:inset 0 -2px 0 rgba(11,12,14,.22);cursor:pointer;transition:background-color .15s,transform .12s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover{background:#FFD23D}.ds-btn-primary:hover .ds-ar{transform:translateX(3px)}.ds-ar{transition:transform .25s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:2px solid #0B0C0E;outline-offset:2px}"
    },
    {
      "name": "Buton de semnal (bara galbenă)",
      "kind": "button",
      "refersTo": "button-sign",
      "description": "Negru cu text galben, pe bara de sus: Tichet nou.",
      "html": "<div class=\"ds-bar-bg\"><button class=\"ds-btn-sign\">+ Tichet nou</button></div>",
      "css": ".ds-bar-bg{background:#FFC400;padding:10px 16px}.ds-btn-sign{height:40px;padding:0 16px;border:0;border-radius:2px;background:#0B0C0E;color:#FFC400;font:700 14px/1 Archivo,system-ui,sans-serif;font-stretch:115%;cursor:pointer}.ds-btn-sign:hover{background:#24272C}.ds-btn-sign:active{transform:scale(.97)}.ds-btn-sign:focus-visible{outline:2px solid #0B0C0E;outline-offset:3px}"
    },
    {
      "name": "Buton quiet (hol)",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Acțiuni secundare: transparent, contur care se întărește la hover.",
      "html": "<button class=\"ds-btn-quiet\">Renunță</button>",
      "css": ".ds-btn-quiet{height:38px;padding:0 16px;border:1px solid #82888F;border-radius:2px;background:transparent;color:#0B0C0E;font:700 14px/1 Archivo,system-ui,sans-serif;cursor:pointer}.ds-btn-quiet:hover{border-color:#0B0C0E;background:#fff}.ds-btn-quiet:focus-visible{outline:2px solid #0B0C0E;outline-offset:2px}"
    },
    {
      "name": "Câmp (hol)",
      "kind": "input",
      "refersTo": "input-hall",
      "description": "Câmp de formular în hol, focus cu inel galben.",
      "html": "<label class=\"ds-lbl\">Ce nu merge?<input class=\"ds-input\" placeholder=\"ex. Câmpul dată nu se completează la import\"></label>",
      "css": ".ds-lbl{display:block;font:700 13px/1.4 Archivo,system-ui,sans-serif;color:#0B0C0E}.ds-input{display:block;margin-top:6px;width:100%;height:40px;padding:0 12px;border:1px solid #82888F;border-radius:2px;background:#fff;color:#0B0C0E;font:400 14px Archivo,system-ui,sans-serif}.ds-input::placeholder{color:#5B6068}.ds-input:hover{border-color:#5B6068}.ds-input:focus{outline:none;border-color:#0B0C0E;box-shadow:0 0 0 3px #FFC400}"
    },
    {
      "name": "Căutare (panou)",
      "kind": "input",
      "refersTo": "input-board",
      "description": "Câmp pe panoul negru, focus și caret galbene.",
      "html": "<div class=\"ds-board\"><input class=\"ds-input-board\" placeholder=\"Caută după cod, titlu, nume\"></div>",
      "css": ".ds-board{background:#0B0C0E;padding:16px}.ds-input-board{width:100%;height:40px;padding:0 12px;border:1px solid #5E636B;border-radius:2px;background:#15171A;color:#F4F4F0;caret-color:#FFC400;font:400 14px Archivo,system-ui,sans-serif}.ds-input-board::placeholder{color:#8F949C}.ds-input-board:focus{outline:none;border-color:#FFC400;box-shadow:0 0 0 1px #FFC400}"
    },
    {
      "name": "Tab-uri (bara galbenă)",
      "kind": "nav",
      "description": "Navigația principală; tab-ul curent e un bloc negru cu text galben.",
      "html": "<nav class=\"ds-tabs\"><a class=\"ds-tab ds-on\" href=\"#\">Tichete</a><a class=\"ds-tab\" href=\"#\">News</a><a class=\"ds-tab\" href=\"#\">Jurnal</a></nav>",
      "css": ".ds-tabs{display:flex;height:60px;background:#FFC400}.ds-tab{display:flex;align-items:center;position:relative;padding:0 16px;color:#0B0C0E;font:700 15px Archivo,system-ui,sans-serif;font-stretch:115%;text-decoration:none}.ds-tab::after{content:'';position:absolute;left:16px;right:16px;bottom:12px;height:3px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .25s cubic-bezier(.16,1,.3,1)}.ds-tab:hover::after{transform:none}.ds-on{background:#0B0C0E;color:#FFC400}.ds-on::after{display:none}.ds-tab:focus-visible{outline:2px solid #0B0C0E;outline-offset:-4px}"
    },
    {
      "name": "Chip de zonă (panou)",
      "kind": "chip",
      "refersTo": "zone-chip-active",
      "description": "Filtru pe zona din WFM Extended: pictogramă, nume, număr; activ galben.",
      "html": "<div class=\"ds-board\"><button class=\"ds-zchip\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M3 14h4.5v7H3zm6.75-5h4.5v12h-4.5zM16.5 3H21v18h-4.5z\"/></svg>Raportare <b>1</b></button> <button class=\"ds-zchip ds-on\" aria-pressed=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M10.5 3h3v8h3.5L12 16.5 7 11h3.5zM3 14h3v4h12v-4h3v7H3z\"/></svg>Import <b>1</b></button></div>",
      "css": ".ds-board{background:#0B0C0E;padding:16px}.ds-zchip{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 12px;border:1px solid #5E636B;border-radius:2px;background:transparent;color:#F4F4F0;font:600 13px Archivo,system-ui,sans-serif;cursor:pointer}.ds-zchip b{font-size:12px;color:#A4A8AF}.ds-zchip svg{transition:transform .45s cubic-bezier(.16,1,.3,1)}.ds-zchip:hover{border-color:#A4A8AF}.ds-zchip:hover svg{transform:rotateY(180deg)}.ds-zchip.ds-on{background:#FFC400;border-color:#FFC400;color:#0B0C0E}.ds-zchip.ds-on b{color:#0B0C0E}.ds-zchip:focus-visible{outline:2px solid #FFC400;outline-offset:2px}"
