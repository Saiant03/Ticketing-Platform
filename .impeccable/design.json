      "html": "<div class=\"ds-board\"><span class=\"ds-flap\"><i>T</i><i>I</i><i>S</i><i>-</i><i>1</i><i>4</i></span> <span class=\"ds-flap ds-work\"><i>Î</i><i>N</i><i> </i><i>L</i><i>U</i><i>C</i><i>R</i><i>U</i></span></div>",
      "css": ".ds-board{background:#0B0C0E;padding:16px;display:flex;gap:16px}.ds-flap{display:inline-flex;gap:2px;color:#F4F4F0;font:700 14px/22px Archivo,system-ui,sans-serif;font-stretch:75%;font-variant-numeric:tabular-nums}.ds-flap i{position:relative;width:14px;height:22px;text-align:center;font-style:normal;white-space:pre;border-radius:2px;background:linear-gradient(#202328 50%,#1A1C20 50%)}.ds-flap i::before{content:'';position:absolute;left:0;right:0;top:calc(50% - .5px);height:1px;background:#050506}.ds-work{color:#FFC400}"
